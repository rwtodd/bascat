    <command:examples>
      <command:example>
        <maml:title>--------- Example 1 ---------</maml:title>
        <maml:introduction>
          <maml:para>```powershell
PS C:\&gt; Get-GWBasicContent myfile.bas &gt; myfile.bas.txt
```</maml:para>
          <maml:para>&#x80;</maml:para>
          <maml:para>Converts `myfile.bas` to plain text, and saves that text into `myfile.bas.txt`.</maml:para>
        </maml:introduction>
        <dev:code />
        <dev:remarks />
      </command:example>
      <command:example>
        <maml:title>--------- Example 2 ---------</maml:title>
        <maml:introduction>
          <maml:para>```powershell
PS C:\&gt; gci *.gwbas | Get-GWBasicContent &gt; myfiles.bas.txt
```</maml:para>
          <maml:para>&#x80;</maml:para>
          <maml:para>Converts all the gwbas files to plain text, and saves that text into `myfiles.bas.txt`.</maml:para>
        </maml:introduction>
        <dev:code />
        <dev:remarks />
